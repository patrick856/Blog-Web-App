<%- include("partials/header.ejs") %>

<section class="blog">
    <div class="big-card">
        <h1><%= blog.title %></h1>
        <p><%= blog.content %></p>
    </div>
    <div class="buttons">
        <form method="POST" action="/blogs/<%= blog.id %>/delete" style="display:inline;">
            <button type="submit">DELETE</button>
        </form>
        <a href="/blogs/<%= blog.id %>/edit">EDIT</a>
    </div>
</section>

<%- include("partials/footer.ejs") %>